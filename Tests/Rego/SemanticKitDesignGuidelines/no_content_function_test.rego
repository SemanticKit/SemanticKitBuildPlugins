# The same ontology spelled `var content`.
test_denies_content_property if {
  every node in [content_property_node, ontology_content_property_node] {
    result := decision with input as node
    count(result.deny) == 1
    result.deny[0].rule_id == "semantickit.design_guidelines.no_content_function"
    result.deny[0].line == 1
    result.deny[0].column == 30
  }
}

test_allows_content_property_of_other_types if {
  result := decision with input as page_content_property_node

  count(result.deny) == 0
}

