# An initializer that takes the IRI as a String, labelled `iri` or with
# `iri` as its parameter name, holds it as the stored form does.
test_denies_iri_string_initializer if {
  result := decision with input as unlabeled_iri_string_initializer_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_stored_iri_identity"
  result.deny[0].line == 1
  result.deny[0].column == 23
}

test_denies_optional_qualified_iri_string_initializer if {
  every node in [labelled_iri_string_initializer_node, unlabeled_optional_qualified_iri_string_initializer_node] {
    result := decision with input as node
    count(result.deny) == 1
    result.deny[0].line == 1
    result.deny[0].column == 18
  }
}

test_allows_iri_string_initializer_of_coder if {
  result := decision with input as decoder_iri_string_initializer_node

  count(result.deny) == 0
}

