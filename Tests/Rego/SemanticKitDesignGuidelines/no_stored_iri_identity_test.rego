# An IRI held as a String is a stored IRI too.
test_denies_iri_stored_as_string if {
  result := decision with input as iri_string_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_stored_iri_identity"
  result.deny[0].line == 1
  result.deny[0].column == 27
}

test_denies_optional_qualified_iri_string if {
  result := decision with input as optional_iri_string_node

  count(result.deny) == 1
  result.deny[0].column == 22
}

# A String `id` or `name` need not be an IRI.
test_allows_other_string_members if {
  result := decision with input as string_id_node

  count(result.deny) == 0
}

