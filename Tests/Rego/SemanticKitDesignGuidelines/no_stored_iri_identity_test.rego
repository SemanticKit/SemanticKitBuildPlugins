package semantickit.design_guidelines.no_stored_iri_identity

test_denies_stored_iri_on_class if {
  result := decision with input as stored_iri_class_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_stored_iri_identity"
  result.deny[0].line == 1
  result.deny[0].column == 26
  result.deny[0].severity == "error"
}

test_denies_stored_iri_var_on_struct if {
  result := decision with input as stored_iri_var_struct_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 21
}

test_denies_optional_qualified_iri if {
  result := decision with input as optional_qualified_iri_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 21
}

test_denies_identifiable_iri_id if {
  result := decision with input as identifiable_iri_id_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 38
}

test_denies_computed_identifiable_iri_id if {
  result := decision with input as computed_identifiable_iri_id_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 38
}

test_denies_protocol_iri_requirement if {
  result := decision with input as protocol_iri_requirement_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 25
}

test_denies_iri_initializer if {
  result := decision with input as iri_initializer_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_stored_iri_identity"
  result.deny[0].line == 1
  result.deny[0].column == 22
}

test_denies_unlabeled_iri_initializer if {
  result := decision with input as unlabeled_iri_initializer_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 19
}

test_denies_individual_made_from_iri if {
  every node in [individual_from_iri_node, individual_init_from_iri_node] {
    result := decision with input as node
    count(result.deny) == 1
    result.deny[0].rule_id == "semantickit.design_guidelines.no_stored_iri_identity"
    result.deny[0].line == 1
    result.deny[0].column == 14
  }
}

# A coder reads and writes IRIs, the identifier types are IRIs, and other
# members and locals are not an identity.
test_allows_boundary_and_other_members if {
  every node in [decoder_iri_member_node, decoder_individual_node, iri_type_initializer_node, other_iri_member_node, local_iri_node, instance_identity_node] {
    result := decision with input as node
    count(result.deny) == 0
  }
}

# A hand-typed IRI is no_hand_typed_iri_member's, a static one
# no_static_iri_constant's: each is reported once.
test_leaves_hand_typed_and_static_iris_to_their_rules if {
  every node in [hand_typed_iri_member_node, static_iri_member_node] {
    result := decision with input as node
    count(result.deny) == 0
  }
}

