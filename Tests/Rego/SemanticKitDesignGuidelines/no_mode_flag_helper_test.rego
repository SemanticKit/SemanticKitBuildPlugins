test_denies_public_method_of_coder_type if {
  result := decision with input as public_coder_method_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_mode_flag_helper"
  result.deny[0].line == 1
  result.deny[0].column == 31
  result.deny[0].severity == "error"
}

test_denies_internal_method_in_extension if {
  result := decision with input as internal_extension_method_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_mode_flag_helper"
  result.deny[0].line == 1
  result.deny[0].column == 28
  result.deny[0].severity == "error"
}

test_allows_public_coder_method_without_flag if {
  result := decision with input as public_coder_method_without_flag_node

  count(result.deny) == 0
}

