# Every IRIAssertion typealias, spelled with `.self` or with its generic
# argument, and module-qualified (`RDFKit.Domain`), is a reference by name.
test_denies_every_iri_assertion_spelling if {
  every node in [type_generic_node, is_defined_by_generic_node, range_metatype_node, subclass_metatype_node, subproperty_metatype_node, is_defined_by_metatype_node, qualified_domain_metatype_node, qualified_type_generic_node, qualified_iri_assertion_node, qualified_domain_init_string_node] {
    result := decision with input as node
    count(result.deny) == 1
    result.deny[0].rule_id == "semantickit.design_guidelines.no_term_reference_by_name"
    result.deny[0].line == 1
    result.deny[0].column == 9
  }
}

# `Swift.Range` is Swift's own; `RDFKit.Domain(Fauna.Animal)` is the natural spelling.
test_allows_qualified_swift_range_and_qualified_reference_by_type if {
  every node in [swift_qualified_range_node, qualified_domain_by_type_node] {
    result := decision with input as node
    count(result.deny) == 0
  }
}

