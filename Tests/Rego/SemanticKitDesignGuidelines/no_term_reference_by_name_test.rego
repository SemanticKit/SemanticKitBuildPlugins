# RDFKit's `Type` and `IsDefinedBy` are `IRIAssertion`s as
# `Domain` is, and `IRIAssertion<…>` itself is the DSL spelled with its
# generic argument.
test_denies_every_iri_assertion_by_name if {
  every node in [type_by_metatype_node, type_by_string_node, is_defined_by_iri_node, iri_assertion_generic_node] {
    result := decision with input as node
    count(result.deny) == 1
    result.deny[0].rule_id == "semantickit.design_guidelines.no_term_reference_by_name"
    result.deny[0].line == 1
    result.deny[0].column == 9
  }
}

test_allows_iri_assertions_by_type if {
  every node in [type_by_type_node, is_defined_by_ontology_node, object_identifier_node] {
    result := decision with input as node
    count(result.deny) == 0
  }
}

