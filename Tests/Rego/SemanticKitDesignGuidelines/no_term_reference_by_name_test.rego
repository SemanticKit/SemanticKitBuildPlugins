# RDFKit's `SeeAlso` is an annotation holding the address of an outside
# document (RDF Schema 1.2 §5.4.1, rdfs:seeAlso), not a term reference: a
# string given to it is that address, not a term referred to by name.
test_allows_see_also_document_address if {
  result := decision with input as see_also_document_address_node
  count(result.deny) == 0
}

