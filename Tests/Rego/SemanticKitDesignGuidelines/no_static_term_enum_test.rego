test_denies_term_factory_static if {
  result := decision with input as term_factory_static_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_static_term_enum"
  result.deny[0].line == 1
  result.deny[0].column == 1
  result.deny[0].severity == "error"
  count(result.warn) == 0
}

