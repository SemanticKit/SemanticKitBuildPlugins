# FoafA to FoafD are `no_static_iri_constant`'s, so each is reported once.
test_leaves_bypass_probes_to_static_iri_constant if {
  every probe in bypass_probes_nodes {
    result := decision with input as probe
    count(result.deny) == 0
  }
}

