# The bypass probes FoafA to FoafD: a static term IRI however it is built.
test_denies_bypass_probes if {
  results := [result | some probe in bypass_probes_nodes; result := decision with input as probe]
  count(results) == 4
  every result in results {
    count(result.deny) == 1
    result.deny[0].rule_id == "semantickit.design_guidelines.no_static_iri_constant"
    result.deny[0].line == 1
  }
  [result.deny[0].column | some result in results] == [14, 14, 14, 16]
}

