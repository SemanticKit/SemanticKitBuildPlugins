# `SeeAlso` holds a document's address and is not a term reference: an
# address built from strings given to it is this rule's.
test_denies_concatenated_see_also if {
  result := decision with input as see_also_by_concatenated_string_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_interpolated_identity"
  result.deny[0].line == 42
  result.deny[0].column == 13
}

