test_denies_string_labelled_from_initializer if {
  result := decision with input as string_labelled_from_initializer_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_interpolated_identity"
  result.deny[0].line == 1
  result.deny[0].column == 56
  result.deny[0].severity == "error"
  count(result.warn) == 0
}

test_denies_string_labelled_encode if {
  result := decision with input as string_labelled_encode_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_interpolated_identity"
  result.deny[0].line == 1
  result.deny[0].column == 58
  result.deny[0].severity == "error"
  count(result.warn) == 0
}

test_allows_decodable_any_decoder if {
  result := decision with input as decodable_any_decoder_node

  count(result.deny) == 0
}

