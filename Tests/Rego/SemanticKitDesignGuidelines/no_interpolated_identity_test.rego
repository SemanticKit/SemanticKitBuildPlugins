# `+=` and `append(_:)` concatenate as `+` does.
test_denies_iri_built_by_compound_assignment if {
  result := decision with input as compound_assignment_iri_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_interpolated_identity"
  result.deny[0].line == 1
  result.deny[0].column == 35
}

test_denies_iri_built_by_append if {
  result := decision with input as append_iri_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 35
}

test_denies_namespace_built_by_append_contents if {
  result := decision with input as append_contents_namespace_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 28
}

test_allows_plain_string_building_and_coders if {
  every node in [plain_compound_assignment_node, decoder_compound_assignment_node, url_append_path_node] {
    result := decision with input as node
    count(result.deny) == 0
  }
}

