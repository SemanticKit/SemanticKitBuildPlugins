# The declaration at the start of the chain, spelled with its module or with
# `.init`.
test_denies_module_qualified_declaration_chain if {
  result := decision with input as module_qualified_chain_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_add_modifier_on_declaration"
  result.deny[0].line == 1
  result.deny[0].column == 1
  result.deny[0].severity == "error"
}

test_denies_init_declaration_chain if {
  result := decision with input as init_chain_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_add_modifier_on_declaration"
  result.deny[0].line == 1
  result.deny[0].column == 1
  result.deny[0].severity == "error"
}

test_denies_module_qualified_init_declaration_chain if {
  result := decision with input as module_qualified_init_chain_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 1
}

test_allows_add_on_instance_spelled_with_init if {
  every node in [init_instance_chain_node, module_qualified_instance_chain_node] {
    result := decision with input as node
    count(result.deny) == 0
  }
}

