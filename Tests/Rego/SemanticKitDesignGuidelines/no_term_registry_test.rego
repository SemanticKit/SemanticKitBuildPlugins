# A registry built from a sequence keyed by each element's IRI.
test_denies_unique_keys_by_iri if {
  result := decision with input as unique_keys_by_iri_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_term_registry"
  result.deny[0].line == 1
  result.deny[0].column == 13
  result.deny[0].severity == "error"
}

test_denies_qualified_dictionary_init_by_iri if {
  result := decision with input as qualified_dictionary_init_by_iri_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 13
}

test_allows_unique_keys_by_other_values if {
  result := decision with input as unique_keys_by_name_node

  count(result.deny) == 0
}

# A cache keyed by String or IRI whose values are a term in scope.
test_denies_string_keyed_term_cache if {
  result := decision with input as in_registry_scope(string_keyed_term_cache_node)

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_term_registry"
  result.deny[0].line == 1
  result.deny[0].column == 13
}

test_denies_qualified_term_cache if {
  result := decision with input as in_registry_scope(qualified_term_cache_node)

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 14
}

test_denies_term_cache_initializer if {
  result := decision with input as in_registry_scope(term_cache_initializer_node)

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 14
}

test_denies_iri_keyed_term_cache if {
  result := decision with input as in_registry_scope(iri_keyed_term_cache_node)

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 13
}

# A String-keyed cache of values that are not terms in scope, and a term
# outside any scope.
test_allows_string_keyed_cache_of_other_values if {
  result := decision with input as in_registry_scope(string_keyed_count_cache_node)
  count(result.deny) == 0

  unscoped := decision with input as string_keyed_term_cache_node
  count(unscoped.deny) == 0
}

in_registry_scope(node) := object.union(node, {"vocabulary": registry_vocabulary})

# Vocabulary of `@Ontology struct Foaf { var body: some Content { Class("Person"); Property("knows") } }; @Ontology struct Fauna { var body: some Content { Class("Animal") } }`.
registry_vocabulary := {"ontologies": ["Fauna", "Foaf"], "terms": ["Animal", "Person", "knows"]}

