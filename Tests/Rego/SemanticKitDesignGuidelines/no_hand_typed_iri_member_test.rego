package semantickit.design_guidelines.no_hand_typed_iri_member

test_denies_stored_literal_iri if {
  result := decision with input as stored_literal_iri_node

  count(result.deny) == 1
  result.deny[0].rule_id == "semantickit.design_guidelines.no_hand_typed_iri_member"
  result.deny[0].line == 1
  result.deny[0].column == 21
  result.deny[0].severity == "error"
}

test_denies_computed_literal_iri if {
  result := decision with input as computed_literal_iri_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 21
}

test_denies_identifiable_literal_iri if {
  result := decision with input as identifiable_literal_iri_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 40
}

test_denies_prefixed_name_member if {
  result := decision with input as prefixed_name_member_node

  count(result.deny) == 1
  result.deny[0].line == 1
  result.deny[0].column == 24
}

test_allows_members_that_are_not_iris_coders_and_locals if {
  every node in [media_type_member_node, decoder_base_member_node, local_iri_string_node, ontology_namespace_node, macro_ontology_namespace_node] {
    result := decision with input as node
    count(result.deny) == 0
  }
}

